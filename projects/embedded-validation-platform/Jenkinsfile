import groovy.json.JsonOutput

pipeline {
    agent any

    environment {
        EVAP_API_URL = 'http://backend:8000'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 10, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {

        stage('Initialize') {
            steps {
                echo 'EVAP CI/CD Pipeline v0.5'
                echo "Build number: ${env.BUILD_NUMBER}"
                echo "Git commit: ${env.GIT_COMMIT}"

                sh '''
                    rm -rf evap-reports
                    mkdir -p evap-reports
                '''
            }
        }

        stage('EVAP Health Check') {
            steps {
                sh '''
                    curl --fail --silent --show-error \
                        --max-time 10 \
                        "$EVAP_API_URL/api/health"
                '''
            }
        }

        stage('Execute SIL Campaign') {
            steps {
                script {
                    def payload = [
                        name: "Jenkins SIL Regression #${env.BUILD_NUMBER}",
                        test_ids: [
                            'TC-004',
                            'TC-008',
                            'TC-009',
                            'TC-011'
                        ]
                    ]

                    writeFile(
                        file: 'evap-reports/campaign-request.json',
                        text: JsonOutput.toJson(payload)
                    )

                    sh '''
                        curl --fail --silent --show-error \
                            --max-time 180 \
                            -X POST \
                            -H "Content-Type: application/json" \
                            --data @evap-reports/campaign-request.json \
                            "$EVAP_API_URL/api/campaigns" \
                            -o evap-reports/campaign-response.json
                    '''

                    def response = readJSON(file: 'evap-reports/campaign-response.json', returnPojo: true)

                    def campaignId = response.campaign_id ?: response.id

                    if (!campaignId) {
                        error('EVAP did not return a campaign ID')
                    }

                    env.EVAP_CAMPAIGN_ID = campaignId.toString()

                    echo "EVAP Campaign ID: ${env.EVAP_CAMPAIGN_ID}"
                }
            }
        }

        stage('Collect Campaign Results') {
            steps {
                sh '''
                    curl --fail --silent --show-error \
                        --max-time 15 \
                        "$EVAP_API_URL/api/campaigns/$EVAP_CAMPAIGN_ID" \
                        -o evap-reports/campaign-details.json
                '''
            }
        }

        stage('Generate JUnit Report') {
            steps {
                script {
                    def campaign = readJSON(
                        file: 'evap-reports/campaign-details.json',
                        returnPojo: true
                    )

                    def executions = campaign.executions ?: []

                    def escapeXml = { value ->
                        (value == null ? '' : value.toString())
                            .replace('&', '&amp;')
                            .replace('<', '&lt;')
                            .replace('>', '&gt;')
                            .replace('"', '&quot;')
                            .replace("'", '&apos;')
                    }

                    def failures = executions.count {
                        it.verdict == 'FAILED'
                    }

                    def errors = executions.count {
                        it.verdict != 'PASSED' &&
                        it.verdict != 'FAILED'
                    }

                    def duration = 0.0

                    executions.each { execution ->
                        duration += (execution.duration_seconds ?: 0)
                    }

                    def xml = '<?xml version="1.0" encoding="UTF-8"?>\n'

                    xml += '<testsuite name="EVAP.SIL"'
                    xml += " tests=\"${executions.size()}\""
                    xml += " failures=\"${failures}\""
                    xml += " errors=\"${errors}\""
                    xml += " skipped=\"0\""
                    xml += " time=\"${duration}\">\n"

                    executions.each { execution ->

                        def testId = escapeXml(execution.test_id)
                        def requirement = escapeXml(
                            execution.requirement_id
                        )
                        def logs = escapeXml(execution.logs)
                        def verdict = execution.verdict
                        def testDuration = execution.duration_seconds ?: 0

                        xml += "  <testcase classname=\"EVAP.SIL.${requirement}\""
                        xml += " name=\"${testId}\""
                        xml += " time=\"${testDuration}\">\n"

                        if (verdict == 'FAILED') {
                            xml += "    <failure message=\"Test failed\">${logs}</failure>\n"
                        } else if (verdict != 'PASSED') {
                            xml += "    <error message=\"Execution error\">${logs}</error>\n"
                        }

                        xml += "    <system-out>${logs}</system-out>\n"
                        xml += '  </testcase>\n'
                    }

                    xml += '</testsuite>\n'

                    writeFile(
                        file: 'evap-reports/junit-results.xml',
                        text: xml,
                        encoding: 'UTF-8'
                    )

                    echo 'EVAP JUnit XML report generated.'

                    junit(
                        testResults: 'evap-reports/junit-results.xml',
                        allowEmptyResults: false
                    )
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    def campaign = readJSON(file: 'evap-reports/campaign-details.json', returnPojo: true)

                    def expectedTests = [
                        'TC-004',
                        'TC-008',
                        'TC-009',
                        'TC-011'
                    ]

                    def executions = campaign.executions ?: []

                    echo '====================================='
                    echo 'EVAP SIL VALIDATION REPORT'
                    echo '====================================='
                    echo "Campaign: ${campaign.name}"
                    echo "Status: ${campaign.status}"
                    echo "Total: ${campaign.total_tests}"
                    echo "Passed: ${campaign.passed}"
                    echo "Failed: ${campaign.failed}"
                    echo "Errors: ${campaign.errors}"
                    echo '-------------------------------------'

                    executions.each { execution ->
                        echo "${execution.test_id}: ${execution.verdict}"
                    }

                    echo '====================================='

                    def actualTests = executions.collect {
                        it.test_id
                    }.sort()

                    if (campaign.status != 'COMPLETED' ||
                        campaign.total_tests != 4 ||
                        campaign.passed != 4 ||
                        campaign.failed != 0 ||
                        campaign.errors != 0 ||
                        executions.size() != 4 ||
                        actualTests != expectedTests.sort() ||
                        executions.any {
                            it.verdict != 'PASSED' ||
                            it.environment != 'SIL'
                        }) {

                        error('EVAP QUALITY GATE FAILED')
                    }

                    echo 'EVAP QUALITY GATE PASSED'
                }
            }
        }

        stage('Verify Dashboard API') {
            steps {
                sh '''
                    curl --fail --silent --show-error \
                        --max-time 10 \
                        "$EVAP_API_URL/api/dashboard" \
                        -o evap-reports/dashboard.json

                    cat evap-reports/dashboard.json
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'evap-reports/*.json,evap-reports/*.xml',
                allowEmptyArchive: true
            )

            echo 'EVAP pipeline finished.'
        }

        success {
            echo 'EVAP SIL validation successfully completed.'
        }

        failure {
            echo 'EVAP SIL validation failed.'
        }
    }
}
