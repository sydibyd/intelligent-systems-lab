import groovy.json.JsonOutput

pipeline {
    agent any

    triggers {
        pollSCM('H/5 * * * *')
    }

    parameters {
        choice(
            name: 'VALIDATION_SCENARIO',
            choices: [
                'NORMAL',
                'UNIT_TEST_FAILURE',
                'TEST_FAILURE',
                'EXECUTION_ERROR',
                'MISSING_RESULT',
                'INTERRUPTED'
            ],
            description: 'EVAP Quality Gate validation scenario'
        )
    }

    environment {
        EVAP_API_URL = 'http://backend:8000'
        EVAP_CI_INSTANCE = 'jenkins-local'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 10, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {

        stage('Initialize') {
            steps {
                echo 'EVAP CI/CD Pipeline v0.5'
                echo "Build number: ${env.BUILD_NUMBER}"
                echo "Git commit: ${env.GIT_COMMIT}"

                sh '''
                    rm -rf evap-reports
                    mkdir -p evap-reports
                '''
            }
        }

        stage('Register CI Build') {
            steps {
                script {
                    def gitCommit = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    def triggerSource = 'UNKNOWN'

                    if (currentBuild.getBuildCauses(
                        'hudson.triggers.SCMTrigger$SCMTriggerCause'
                    ).size() > 0) {
                        triggerSource = 'SCM'
                    } else if (currentBuild.getBuildCauses(
                        'hudson.model.Cause$UserIdCause'
                    ).size() > 0) {
                        triggerSource = 'MANUAL'
                    }

                    def payload = [
                        ci_instance: env.EVAP_CI_INSTANCE,
                        pipeline_name: env.JOB_NAME,
                        build_number: env.BUILD_NUMBER.toInteger(),
                        build_url: env.BUILD_URL,
                        git_commit: gitCommit,
                        git_branch: env.GIT_BRANCH ?: 'UNKNOWN',
                        trigger_source: triggerSource,
                        validation_scenario: params.VALIDATION_SCENARIO
                    ]

                    writeJSON(
                        file: 'evap-reports/ci-build-request.json',
                        json: payload,
                        pretty: 4
                    )

                    sh '''
                        curl --fail --silent --show-error \\
                            --max-time 15 \\
                            --retry 2 \\
                            -X POST \\
                            -H "Content-Type: application/json" \\
                            --data @evap-reports/ci-build-request.json \\
                            "$EVAP_API_URL/api/ci-builds" \\
                            -o evap-reports/ci-build-registration.json
                    '''

                    def registered = readJSON(
                        file: 'evap-reports/ci-build-registration.json',
                        returnPojo: true
                    )

                    if (!registered.id ||
                        registered.git_commit != gitCommit ||
                        registered.status != 'RUNNING') {
                        error('Invalid CI build registration')
                    }

                    env.EVAP_CI_BUILD_ID = registered.id.toString()

                    echo "EVAP CI Build ID: ${env.EVAP_CI_BUILD_ID}"
                    echo "Git SHA: ${gitCommit}"
                    echo "Trigger source: ${triggerSource}"
                    echo 'EVAP BUILD REGISTRATION PASSED'
                }
            }
        }

        stage('Setup Python Environment') {
            steps {
                sh '''
                    set -eu

                    echo "=== PYTHON RUNTIME ==="
                    python3 --version

                    rm -rf .evap-venv
                    python3 -m venv .evap-venv

                    echo "=== INSTALL BACKEND DEPENDENCIES ==="
                    .evap-venv/bin/python -m pip install \
                        --disable-pip-version-check \
                        -r projects/embedded-validation-platform/backend/requirements.txt

                    .evap-venv/bin/python -m pip check
                '''
            }
        }

        stage('Backend Unit Tests') {
            steps {
                script {
                    if (params.VALIDATION_SCENARIO == 'UNIT_TEST_FAILURE') {
                        currentBuild.description =
                            'SYNTHETIC VALIDATION: UNIT_TEST_FAILURE'

                        echo 'WARNING: SYNTHETIC UNIT TEST FAILURE INJECTION'
                    }

                    def testStatus = sh(
                        returnStatus: true,
                        script: '''
                            set -eu

                            export DATABASE_URL="postgresql://evap:evap@localhost:5432/evap"
                            export PYTHONDONTWRITEBYTECODE=1
                            export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1

                            WORKSPACE_ROOT="$PWD"

                            cd projects/embedded-validation-platform/backend

                            set -- tests/

                            if [ "$VALIDATION_SCENARIO" = "UNIT_TEST_FAILURE" ]; then
                                SYNTHETIC_DIR="$(mktemp -d)"

                                trap 'rm -rf "$SYNTHETIC_DIR"' EXIT

                                cat > "$SYNTHETIC_DIR/test_synthetic_unit_failure.py" <<'EOF'
def test_synthetic_unit_failure():
    assert False, "SYNTHETIC: Unit test failure injected"
EOF

                                set -- "$@" "$SYNTHETIC_DIR/test_synthetic_unit_failure.py"

                                echo "Synthetic unit test injected."
                            fi

                            "$WORKSPACE_ROOT/.evap-venv/bin/python" -m pytest \
                                -v \
                                -p no:cacheprovider \
                                --junitxml="$WORKSPACE_ROOT/evap-reports/backend-unit-results.xml" \
                                "$@"
                        '''
                    )

                    if (fileExists('evap-reports/backend-unit-results.xml')) {
                        junit(
                            testResults: 'evap-reports/backend-unit-results.xml',
                            allowEmptyResults: false
                        )
                    } else {
                        error('Backend unit test report was not generated')
                    }

                    if (testStatus != 0) {
                        error("EVAP UNIT TEST QUALITY GATE FAILED: exit code ${testStatus}")
                    }

                    if (params.VALIDATION_SCENARIO == 'UNIT_TEST_FAILURE') {
                        error('Synthetic unit test unexpectedly passed')
                    }

                    echo 'EVAP UNIT TEST QUALITY GATE PASSED'
                }
            }
        }

        stage('EVAP Health Check') {
            steps {
                sh '''
                    curl --fail --silent --show-error \
                        --max-time 10 \
                        "$EVAP_API_URL/api/health"
                '''
            }
        }

        stage('Execute SIL Campaign') {
            steps {
                script {
                    def payload = [
                        name: "Jenkins SIL Regression #${env.BUILD_NUMBER}",
                        ci_build_id: env.EVAP_CI_BUILD_ID.toLong(),
                        test_ids: [
                            'TC-004',
                            'TC-008',
                            'TC-009',
                            'TC-011'
                        ]
                    ]

                    writeFile(
                        file: 'evap-reports/campaign-request.json',
                        text: JsonOutput.toJson(payload)
                    )

                    sh '''
                        curl --fail --silent --show-error \
                            --max-time 180 \
                            -X POST \
                            -H "Content-Type: application/json" \
                            --data @evap-reports/campaign-request.json \
                            "$EVAP_API_URL/api/campaigns" \
                            -o evap-reports/campaign-response.json
                    '''

                    def response = readJSON(file: 'evap-reports/campaign-response.json', returnPojo: true)

                    def campaignId = response.campaign_id ?: response.id

                    if (!campaignId) {
                        error('EVAP did not return a campaign ID')
                    }

                    if (response.ci_build_id?.toString() !=
                        env.EVAP_CI_BUILD_ID) {
                        error('CI build and campaign association mismatch')
                    }

                    env.EVAP_CAMPAIGN_ID = campaignId.toString()

                    echo 'EVAP CAMPAIGN ASSOCIATION PASSED'

                    echo "EVAP Campaign ID: ${env.EVAP_CAMPAIGN_ID}"
                }
            }
        }

        stage('Collect Campaign Results') {
            steps {
                sh '''
                    curl --fail --silent --show-error \
                        --max-time 15 \
                        "$EVAP_API_URL/api/campaigns/$EVAP_CAMPAIGN_ID" \
                        -o evap-reports/campaign-details.json
                '''
            }
        }

        stage('Prepare Validation Results') {
            steps {
                script {
                    def campaign = readJSON(
                        file: 'evap-reports/campaign-details.json',
                        returnPojo: true
                    )

                    if (campaign.ci_build_id?.toString() !=
                        env.EVAP_CI_BUILD_ID) {
                        error('Persisted campaign association mismatch')
                    }

                    def scenario = params.VALIDATION_SCENARIO

                    echo "Validation scenario: ${scenario}"

                    if (scenario != 'NORMAL') {

                        if (campaign.status != 'COMPLETED' ||
                            campaign.passed != 4 ||
                            campaign.failed != 0 ||
                            campaign.errors != 0 ||
                            campaign.executions.size() != 4) {
                            error('Fault injection requires a nominal campaign')
                        }

                        currentBuild.description =
                            "SYNTHETIC VALIDATION: ${scenario}"

                        campaign.synthetic_validation = true
                        campaign.validation_scenario = scenario

                        echo 'WARNING: SYNTHETIC FAULT INJECTION'

                        if (scenario == 'TEST_FAILURE') {
                            campaign.executions[0].verdict = 'FAILED'
                            campaign.executions[0].logs =
                                'SYNTHETIC: Functional failure injected'
                            campaign.passed = 3
                            campaign.failed = 1

                        } else if (scenario == 'EXECUTION_ERROR') {
                            campaign.executions[0].verdict = 'ERROR'
                            campaign.executions[0].logs =
                                'SYNTHETIC: Execution error injected'
                            campaign.passed = 3
                            campaign.errors = 1
                            campaign.status = 'COMPLETED_WITH_ERRORS'

                        } else if (scenario == 'MISSING_RESULT') {
                            campaign.executions.remove(0)
                            campaign.passed = 3

                        } else if (scenario == 'INTERRUPTED') {
                            campaign.status = 'INTERRUPTED'

                        } else {
                            error("Unknown scenario: ${scenario}")
                        }
                    }

                    writeJSON(
                        file: 'evap-reports/validation-results.json',
                        json: campaign,
                        pretty: 4
                    )

                    echo 'Validation results prepared.'
                }
            }
        }

        stage('Generate JUnit Report') {
            steps {
                script {
                    def campaign = readJSON(
                        file: 'evap-reports/validation-results.json',
                        returnPojo: true
                    )

                    def executions = campaign.executions ?: []

                    def escapeXml = { value ->
                        (value == null ? '' : value.toString())
                            .replace('&', '&amp;')
                            .replace('<', '&lt;')
                            .replace('>', '&gt;')
                            .replace('"', '&quot;')
                            .replace("'", '&apos;')
                    }

                    def failures = executions.count {
                        it.verdict == 'FAILED'
                    }

                    def errors = executions.count {
                        it.verdict != 'PASSED' &&
                        it.verdict != 'FAILED'
                    }

                    def duration = 0.0

                    executions.each { execution ->
                        duration += (execution.duration_seconds ?: 0)
                    }

                    def xml = '<?xml version="1.0" encoding="UTF-8"?>\n'

                    xml += '<testsuite name="EVAP.SIL"'
                    xml += " tests=\"${executions.size()}\""
                    xml += " failures=\"${failures}\""
                    xml += " errors=\"${errors}\""
                    xml += " skipped=\"0\""
                    xml += " time=\"${duration}\">\n"

                    executions.each { execution ->

                        def testId = escapeXml(execution.test_id)
                        def requirement = escapeXml(
                            execution.requirement_id
                        )
                        def logs = escapeXml(execution.logs)
                        def verdict = execution.verdict
                        def testDuration = execution.duration_seconds ?: 0

                        xml += "  <testcase classname=\"EVAP.SIL.${requirement}\""
                        xml += " name=\"${testId}\""
                        xml += " time=\"${testDuration}\">\n"

                        if (verdict == 'FAILED') {
                            xml += "    <failure message=\"Test failed\">${logs}</failure>\n"
                        } else if (verdict != 'PASSED') {
                            xml += "    <error message=\"Execution error\">${logs}</error>\n"
                        }

                        xml += "    <system-out>${logs}</system-out>\n"
                        xml += '  </testcase>\n'
                    }

                    xml += '</testsuite>\n'

                    writeFile(
                        file: 'evap-reports/junit-results.xml',
                        text: xml,
                        encoding: 'UTF-8'
                    )

                    echo 'EVAP JUnit XML report generated.'

                    junit(
                        testResults: 'evap-reports/junit-results.xml',
                        allowEmptyResults: false
                    )
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    def campaign = readJSON(file: 'evap-reports/validation-results.json', returnPojo: true)

                    def expectedTests = [
                        'TC-004',
                        'TC-008',
                        'TC-009',
                        'TC-011'
                    ]

                    def executions = campaign.executions ?: []

                    echo '====================================='
                    echo 'EVAP SIL VALIDATION REPORT'
                    echo '====================================='
                    echo "Campaign: ${campaign.name}"
                    echo "Status: ${campaign.status}"
                    echo "Total: ${campaign.total_tests}"
                    echo "Passed: ${campaign.passed}"
                    echo "Failed: ${campaign.failed}"
                    echo "Errors: ${campaign.errors}"
                    echo '-------------------------------------'

                    executions.each { execution ->
                        echo "${execution.test_id}: ${execution.verdict}"
                    }

                    echo '====================================='

                    def actualTests = executions.collect {
                        it.test_id
                    }.sort()

                    if (campaign.status != 'COMPLETED' ||
                        campaign.total_tests != 4 ||
                        campaign.passed != 4 ||
                        campaign.failed != 0 ||
                        campaign.errors != 0 ||
                        executions.size() != 4 ||
                        actualTests != expectedTests.sort() ||
                        executions.any {
                            it.verdict != 'PASSED' ||
                            it.environment != 'SIL'
                        }) {

                        error('EVAP QUALITY GATE FAILED')
                    }

                    echo 'EVAP QUALITY GATE PASSED'
                }
            }
        }

        stage('Verify Dashboard API') {
            steps {
                sh '''
                    curl --fail --silent --show-error \
                        --max-time 10 \
                        "$EVAP_API_URL/api/dashboard" \
                        -o evap-reports/dashboard.json

                    cat evap-reports/dashboard.json
                '''
            }
        }
    }

    post {
        always {
            script {
                if (env.EVAP_CI_BUILD_ID?.trim()) {
                    def finalStatus = currentBuild.currentResult

                    writeJSON(
                        file: 'evap-reports/ci-build-finalization-request.json',
                        json: [status: finalStatus],
                        pretty: 4
                    )

                    try {
                        sh '''
                            curl --fail --silent --show-error \\
                                --max-time 15 \\
                                --retry 2 \\
                                -X PATCH \\
                                -H "Content-Type: application/json" \\
                                --data @evap-reports/ci-build-finalization-request.json \\
                                "$EVAP_API_URL/api/ci-builds/$EVAP_CI_BUILD_ID" \\
                                -o evap-reports/ci-build-finalization.json
                        '''

                        def finalized = readJSON(
                            file: 'evap-reports/ci-build-finalization.json',
                            returnPojo: true
                        )

                        if (finalized.id?.toString() != env.EVAP_CI_BUILD_ID ||
                            finalized.status != finalStatus ||
                            !finalized.completed_at) {
                            error('Invalid CI build finalization response')
                        }

                        echo "EVAP CI Build final status: ${finalized.status}"
                        echo 'EVAP BUILD FINALIZATION PASSED'

                    } catch (Exception exc) {
                        currentBuild.result = 'FAILURE'
                        echo "EVAP BUILD FINALIZATION FAILED: ${exc}"
                        echo 'WARNING: CI build may require reconciliation'
                    }

                } else {
                    echo 'WARNING: No registered EVAP CI build ID'
                }
            }

            archiveArtifacts(
                artifacts: 'evap-reports/*.json,evap-reports/*.xml',
                allowEmptyArchive: true
            )

            echo 'EVAP pipeline finished.'
        }

        success {
            echo 'EVAP backend and SIL validation successfully completed.'
        }

        failure {
            echo 'EVAP CI/CD validation failed.'
        }
    }
}
